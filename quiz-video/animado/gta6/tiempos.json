{
 "duracion": 80.331,
 "frases": [
  {
   "n": 1,
   "texto": "Si vas a jugar a GTA 6 el día que salga, no cometas estos errores.",
   "ini": 0.5,
   "fin": 5.149
  },
  {
   "n": 2,
   "texto": "Primero, lo que no haría ni loco.",
   "ini": 5.499,
   "fin": 8.07
  },
  {
   "n": 3,
   "texto": "Ir directo al online.",
   "ini": 8.17,
   "fin": 9.637
  },
  {
   "n": 4,
   "texto": "Has esperado trece años… para que un niño te reviente en la primera esquina.",
   "ini": 9.737,
   "fin": 14.238
  },
  {
   "n": 5,
   "texto": "Ver vídeos en TikTok o YouTube.",
   "ini": 14.338,
   "fin": 16.433
  },
  {
   "n": 6,
   "texto": "Más de una década de espera, para que un clip de treinta segundos te cuente el final.",
   "ini": 16.533,
   "fin": 21.299
  },
  {
   "n": 7,
   "texto": "Ahora, lo que me pensaría.",
   "ini": 21.399,
   "fin": 23.129
  },
  {
   "n": 8,
   "texto": "Comprar la edición más cara.",
   "ini": 23.229,
   "fin": 25.011
  },
  {
   "n": 9,
   "texto": "Pagas de más por un coche dorado que consigues jugando en una semana.",
   "ini": 25.111,
   "fin": 28.679
  },
  {
   "n": 10,
   "texto": "Pedir vacaciones para jugarlo.",
   "ini": 28.779,
   "fin": 30.527
  },
  {
   "n": 11,
   "texto": "Tres días de gloria… y vuelves al trabajo con ojeras y sin un euro.",
   "ini": 30.627,
   "fin": 34.795
  },
  {
   "n": 12,
   "texto": "Y ahora, lo que sí haría.",
   "ini": 35.195,
   "fin": 37.156
  },
  {
   "n": 13,
   "texto": "Uno: jugar la historia sin prisa. La primera vez que la vives no se repite.",
   "ini": 37.256,
   "fin": 42.479
  },
  {
   "n": 14,
   "texto": "Dos: perderme en Vice City sin misiones. De noche, con la radio puesta y sin mirar el mapa.",
   "ini": 42.579,
   "fin": 48.843
  },
  {
   "n": 15,
   "texto": "Ahí es donde GTA se vuelve GTA.",
   "ini": 48.943,
   "fin": 51.827
  },
  {
   "n": 16,
   "texto": "Tres: silenciar las redes. Mutear GTA, Lucía y Jason en todas partes.",
   "ini": 51.927,
   "fin": 57.796
  },
  {
   "n": 17,
   "texto": "Cuatro: liberar espacio en la consola antes. Nadie quiere borrar juegos a las doce de la noche.",
   "ini": 57.896,
   "fin": 63.566
  },
  {
   "n": 18,
   "texto": "Y cinco, la sorpresa: darle una vuelta al Vice City de 2002.",
   "ini": 63.866,
   "fin": 68.453
  },
  {
   "n": 19,
   "texto": "Ver de dónde venimos hace que el primer paseo por la nueva ciudad pegue el doble.",
   "ini": 68.553,
   "fin": 73.022
  },
  {
   "n": 20,
   "texto": "Porque la primera semana de GTA 6 no vuelve. Y el que la desperdicia… ya no la recupera.",
   "ini": 73.122,
   "fin": 79.131
  }
 ],
