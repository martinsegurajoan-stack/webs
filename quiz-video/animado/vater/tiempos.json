{
 "duracion": 69.706,
 "frases": [
  {
   "n": 1,
   "texto": "Esto es lo que le pasa a tu caca cuando tiras de la cadena a diez mil metros de altura.",
   "ini": 0.5,
   "fin": 5.501
  },
  {
   "n": 2,
   "texto": "Asiento treinta y dos. Llevas una hora aguantando.",
   "ini": 5.851,
   "fin": 9.493
  },
  {
   "n": 3,
   "texto": "Saltas por encima de dos señores dormidos.",
   "ini": 9.593,
   "fin": 12.168
  },
  {
   "n": 4,
   "texto": "Hay cola. Y se enciende la luz de los cinturones.",
   "ini": 12.268,
   "fin": 15.49
  },
  {
   "n": 5,
   "texto": "Entras en un baño del tamaño de un armario.",
   "ini": 15.59,
   "fin": 18.174
  },
  {
   "n": 6,
   "texto": "Echas el pestillo, te sientas… y turbulencias.",
   "ini": 18.274,
   "fin": 22.294
  },
  {
   "n": 7,
   "texto": "Cuando terminas, pulsas el botón.",
   "ini": 22.394,
   "fin": 24.356
  },
  {
   "n": 8,
   "texto": "Se abre una trampilla en la taza y suena un rugido brutal.",
   "ini": 24.456,
   "fin": 28.08
  },
  {
   "n": 9,
   "texto": "No es agua. Es aire.",
   "ini": 28.33,
   "fin": 30.123
  },
  {
   "n": 10,
   "texto": "Fuera, la presión es mucho más baja que dentro, y el tubo lo aspira todo como una aspiradora gigante.",
   "ini": 30.223,
   "fin": 36.342
  },
  {
   "n": 11,
   "texto": "En un segundo, la taza queda limpia.",
   "ini": 36.442,
   "fin": 38.805
  },
  {
   "n": 12,
   "texto": "Todo viaja por tuberías bajo el suelo, justo debajo de los pasajeros,",
   "ini": 38.905,
   "fin": 42.907
  },
  {
   "n": 13,
   "texto": "hasta un depósito en la cola. Ahí se queda todo el vuelo.",
   "ini": 43.007,
   "fin": 46.629
  },
  {
   "n": 14,
   "texto": "Al aterrizar, llega un camión especial.",
   "ini": 47.029,
   "fin": 49.347
  },
  {
   "n": 15,
   "texto": "Un operario engancha una manguera, abre la válvula y lo vacía en minutos.",
   "ini": 49.447,
   "fin": 54.027
  },
  {
   "n": 16,
   "texto": "Agua, desinfectante azul, y listo para otro vuelo.",
   "ini": 54.127,
   "fin": 57.627
  },
  {
   "n": 17,
   "texto": "Pero a veces, la válvula gotea en pleno vuelo.",
   "ini": 58.027,
   "fin": 60.908
  },
  {
   "n": 18,
   "texto": "Se congela en el fuselaje y forma un bloque de hielo azul.",
   "ini": 61.008,
   "fin": 64.429
  },
  {
   "n": 19,
   "texto": "Y cuando el avión baja… se suelta. Directo hacia un tejado.",
   "ini": 64.529,
   "fin": 69.106
  }
 ],
