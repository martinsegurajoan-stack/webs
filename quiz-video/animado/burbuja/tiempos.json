{
 "duracion": 71.323,
 "frases": [
  {
   "n": 1,
   "texto": "Te meten en una burbuja de fútbol, la cuelgan de un helicóptero… y a mil metros de altura, cortan la cuerda.",
   "ini": 0.5,
   "fin": 7.216
  },
  {
   "n": 2,
   "texto": "Primero te atan dentro: cabeza y pecho en la burbuja, piernas colgando.",
   "ini": 7.516,
   "fin": 12.108
  },
  {
   "n": 3,
   "texto": "El helicóptero despega y tus pies dejan de tocar el césped.",
   "ini": 12.208,
   "fin": 15.641
  },
  {
   "n": 4,
   "texto": "A cien metros, la burbuja empieza a girar como una peonza.",
   "ini": 15.741,
   "fin": 19.315
  },
  {
   "n": 5,
   "texto": "A quinientos, el viento te congela las piernas y el piloto ni te mira.",
   "ini": 19.415,
   "fin": 23.848
  },
  {
   "n": 6,
   "texto": "A mil metros, silencio. Alguien saca unas tijeras.",
   "ini": 23.948,
   "fin": 27.95
  },
  {
   "n": 7,
   "texto": "Y cortan.",
   "ini": 28.25,
   "fin": 28.936
  },
  {
   "n": 8,
   "texto": "El primer segundo, tu estómago se queda arriba.",
   "ini": 29.236,
   "fin": 31.937
  },
  {
   "n": 9,
   "texto": "Al tercero, ya vas a casi cien kilómetros por hora.",
   "ini": 32.037,
   "fin": 35.241
  },
  {
   "n": 10,
   "texto": "El aire frena la burbuja, pero mucho menos de lo que crees.",
   "ini": 35.341,
   "fin": 38.657
  },
  {
   "n": 11,
   "texto": "Llegas a unos ciento cuarenta, y de ahí ya no pasas.",
   "ini": 38.757,
   "fin": 42.405
  },
  {
   "n": 12,
   "texto": "Caes casi medio minuto, dando vueltas y gritando.",
   "ini": 42.505,
   "fin": 45.822
  },
  {
   "n": 13,
   "texto": "Los pájaros te miran. Una avioneta te esquiva. Abajo, un campo de fútbol se hace enorme.",
   "ini": 45.922,
   "fin": 52.34
  },
  {
   "n": 14,
   "texto": "La burbuja solo te salva de caídas pequeñas, como un segundo piso.",
   "ini": 52.44,
   "fin": 56.458
  },
  {
   "n": 15,
   "texto": "Desde mil metros, es como estamparte contra un muro a toda velocidad.",
   "ini": 56.558,
   "fin": 60.891
  },
  {
   "n": 16,
   "texto": "Quedan cien metros. Los jugadores levantan la cabeza.",
   "ini": 60.991,
   "fin": 64.424
  },
  {
   "n": 17,
   "texto": "Cincuenta. El portero sale corriendo.",
   "ini": 64.524,
   "fin": 67.123
  },
  {
   "n": 18,
   "texto": "Diez…",
   "ini": 67.523,
   "fin": 68.155
  },
  {
   "n": 19,
   "texto": "Y la burbuja… explota.",
   "ini": 68.655,
   "fin": 70.723
  }
 ],
