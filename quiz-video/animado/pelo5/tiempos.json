{
 "duracion": 62.068,
 "frases": [
  {
   "n": 1,
   "texto": "¿Qué pasaría si no te cortas el pelo en cinco años?",
   "ini": 0.0,
   "fin": 2.988
  },
  {
   "n": 2,
   "texto": "Empiezas con un pelo.",
   "ini": 3.238,
   "fin": 4.734
  },
  {
   "n": 3,
   "texto": "Bueno… con cien mil.",
   "ini": 4.984,
   "fin": 6.375
  },
  {
   "n": 4,
   "texto": "Y cada uno crece algo más de un centímetro al mes.",
   "ini": 6.925,
   "fin": 9.852
  },
  {
   "n": 5,
   "texto": "Uno. Mes seis: siete centímetros.",
   "ini": 10.102,
   "fin": 12.065
  },
  {
   "n": 6,
   "texto": "El flequillo te tapa los ojos.",
   "ini": 12.315,
   "fin": 14.282
  },
  {
   "n": 7,
   "texto": "Y ningún peinado aguanta en su sitio.",
   "ini": 14.532,
   "fin": 16.861
  },
  {
   "n": 8,
   "texto": "Dos. Año dos: treinta centímetros.",
   "ini": 17.111,
   "fin": 19.224
  },
  {
   "n": 9,
   "texto": "Los nudos son diarios.",
   "ini": 19.474,
   "fin": 20.985
  },
  {
   "n": 10,
   "texto": "Y secarlo ya te lleva media mañana.",
   "ini": 21.235,
   "fin": 23.511
  },
  {
   "n": 11,
   "texto": "Tres. Año tres: cuarenta y cinco centímetros.",
   "ini": 23.761,
   "fin": 26.444
  },
  {
   "n": 12,
   "texto": "Se te engancha en las puertas.",
   "ini": 26.694,
   "fin": 28.438
  },
  {
   "n": 13,
   "texto": "En la cremallera de la chaqueta.",
   "ini": 28.688,
   "fin": 30.421
  },
  {
   "n": 14,
   "texto": "Y acaba dentro de la sopa.",
   "ini": 30.671,
   "fin": 32.321
  },
  {
   "n": 15,
   "texto": "Cuatro. Y aquí viene lo que casi nadie sabe.",
   "ini": 33.171,
   "fin": 35.7
  },
  {
   "n": 16,
   "texto": "Tu pelo puede dejar de crecer.",
   "ini": 35.95,
   "fin": 37.939
  },
  {
   "n": 17,
   "texto": "Cada pelo crece solo de dos a siete años.",
   "ini": 38.189,
   "fin": 40.837
  },
  {
   "n": 18,
   "texto": "Depende de tus genes.",
   "ini": 41.087,
   "fin": 42.488
  },
  {
   "n": 19,
   "texto": "Por eso hay gente que nunca consigue tenerlo largo.",
   "ini": 42.738,
   "fin": 45.869
  },
  {
   "n": 20,
   "texto": "Después se cae, y nace otro nuevo.",
   "ini": 46.119,
   "fin": 48.192
  },
  {
   "n": 21,
   "texto": "Si tus genes aguantan, a los cinco años llegas a setenta y cinco centímetros.",
   "ini": 48.442,
   "fin": 53.139
  },
  {
   "n": 22,
   "texto": "Casi hasta la cintura.",
   "ini": 53.389,
   "fin": 54.905
  },
  {
   "n": 23,
   "texto": "Y por el camino habrás perdido entre noventa mil y ciento ochenta mil pelos.",
   "ini": 55.155,
   "fin": 59.511
  },
  {
   "n": 24,
   "texto": "Porque todo empezó con un solo pelo.",
   "ini": 59.761,
   "fin": 62.068
  }
 ],
