{
 "duracion": 71.472,
 "frases": [
  {
   "n": 1,
   "texto": "¿Qué pasaría si te despertaras del tamaño de una hormiga… en tu propia casa?",
   "ini": 0.0,
   "fin": 4.959
  },
  {
   "n": 2,
   "texto": "Mides tres milímetros.",
   "ini": 5.159,
   "fin": 6.869
  },
  {
   "n": 3,
   "texto": "Tu cama es ahora un desierto de sábanas.",
   "ini": 7.369,
   "fin": 9.812
  },
  {
   "n": 4,
   "texto": "Para llegar a la cocina tienes que cruzar diez metros… que para ti son casi seis kilómetros.",
   "ini": 10.012,
   "fin": 15.705
  },
  {
   "n": 5,
   "texto": "Por el camino, el polvo se mueve.",
   "ini": 15.905,
   "fin": 18.19
  },
  {
   "n": 6,
   "texto": "Son ácaros… y ahora son como hámsteres.",
   "ini": 18.39,
   "fin": 21.412
  },
  {
   "n": 7,
   "texto": "Pero hay una buena noticia: ahora eres fortísimo.",
   "ini": 21.912,
   "fin": 25.519
  },
  {
   "n": 8,
   "texto": "Puedes levantar muchas veces tu propio peso.",
   "ini": 25.719,
   "fin": 28.29
  },
  {
   "n": 9,
   "texto": "Y si te caes de la mesa… no te pasa nada. El aire te frena.",
   "ini": 28.49,
   "fin": 32.477
  },
  {
   "n": 10,
   "texto": "En la cocina, una miga de pan es una roca de tres metros.",
   "ini": 32.977,
   "fin": 36.823
  },
  {
   "n": 11,
   "texto": "Lo malo es que tienes frío todo el rato: un cuerpo tan pequeño pierde calor muy rápido.",
   "ini": 37.023,
   "fin": 43.096
  },
  {
   "n": 12,
   "texto": "Así que tienes que comer casi sin parar.",
   "ini": 43.296,
   "fin": 45.633
  },
  {
   "n": 13,
   "texto": "Y cuidado con el agua: una gota del grifo puede atraparte como si fuera pegamento.",
   "ini": 45.833,
   "fin": 50.833
  },
  {
   "n": 14,
   "texto": "Y entonces… llega el gato.",
   "ini": 51.033,
   "fin": 53.23
  },
  {
   "n": 15,
   "texto": "Para ti, es tan alto como un edificio de cincuenta pisos.",
   "ini": 53.73,
   "fin": 57.709
  },
  {
   "n": 16,
   "texto": "Corres a esconderte debajo del sofá.",
   "ini": 57.909,
   "fin": 59.761
  },
  {
   "n": 17,
   "texto": "A medianoche, el reloj marca las doce… y vuelves a tu tamaño.",
   "ini": 60.261,
   "fin": 64.662
  },
  {
   "n": 18,
   "texto": "Pero desde hoy, miras el suelo de otra manera… porque ahí abajo hay todo un mundo.",
   "ini": 64.862,
   "fin": 70.572
  }
 ],
