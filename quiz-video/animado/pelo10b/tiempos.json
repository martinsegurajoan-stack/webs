{
 "duracion": 57.47,
 "frases": [
  {
   "n": 1,
   "texto": "¿Qué pasaría si no te cortas el pelo en diez años?",
   "ini": 0.0,
   "fin": 3.132
  },
  {
   "n": 2,
   "texto": "Empiezas con un pelo.",
   "ini": 3.352,
   "fin": 4.768
  },
  {
   "n": 3,
   "texto": "Bueno… con cien mil.",
   "ini": 4.988,
   "fin": 7.076
  },
  {
   "n": 4,
   "texto": "Y cada uno crece algo más de un centímetro al mes.",
   "ini": 7.596,
   "fin": 10.756
  },
  {
   "n": 5,
   "texto": "Al primer año, ya tienes quince centímetros.",
   "ini": 10.976,
   "fin": 13.894
  },
  {
   "n": 6,
   "texto": "El flequillo te tapa los ojos.",
   "ini": 14.114,
   "fin": 16.165
  },
  {
   "n": 7,
   "texto": "A los tres años, ¡cuarenta y cinco centímetros!",
   "ini": 16.385,
   "fin": 19.554
  },
  {
   "n": 8,
   "texto": "Se te engancha en las puertas.",
   "ini": 19.774,
   "fin": 21.486
  },
  {
   "n": 9,
   "texto": "Y acaba dentro de la sopa.",
   "ini": 21.706,
   "fin": 23.526
  },
  {
   "n": 10,
   "texto": "A los cinco años, ya te llega casi a la cintura.",
   "ini": 24.246,
   "fin": 27.432
  },
  {
   "n": 11,
   "texto": "Y aquí viene lo que casi nadie sabe.",
   "ini": 27.652,
   "fin": 29.89
  },
  {
   "n": 12,
   "texto": "Tu pelo no crece para siempre.",
   "ini": 30.11,
   "fin": 32.42
  },
  {
   "n": 13,
   "texto": "Cada pelo vive solo de dos a siete años.",
   "ini": 32.64,
   "fin": 35.605
  },
  {
   "n": 14,
   "texto": "Después se cae… y nace otro nuevo.",
   "ini": 35.825,
   "fin": 38.462
  },
  {
   "n": 15,
   "texto": "Así que a los diez años, tu melena se queda en un metro, como mucho.",
   "ini": 38.982,
   "fin": 43.528
  },
  {
   "n": 16,
   "texto": "Salvo que tengas unos genes únicos…",
   "ini": 43.748,
   "fin": 46.187
  },
  {
   "n": 17,
   "texto": "como Xie Qiuping, ¡que lo tiene de más de cinco metros!",
   "ini": 46.407,
   "fin": 50.142
  },
  {
   "n": 18,
   "texto": "Y por el camino habrás perdido unos trescientos mil pelos.",
   "ini": 50.762,
   "fin": 54.425
  },
  {
   "n": 19,
   "texto": "Porque todo empezó… con un solo pelo.",
   "ini": 54.645,
   "fin": 57.47
  }
 ],
